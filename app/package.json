{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check-data && npm run check-codes && npm run check-trust && tsc -b && vite build",
    "build:e2e": "npm run build -- --base=/lattice-atlas/",
    "postbuild": "node scripts/create-route-shells.mjs",
    "check-bundles": "node scripts/check-release-budgets.mjs",
    "check-data": "node scripts/check-data.mjs",
    "check-trust": "node scripts/check-trust.mjs",
    "verify-lattice": "node scripts/verify-lattice.mjs",
    "lint": "eslint .",
    "prepare-images": "node scripts/prepare-images.mjs",
    "preview": "vite preview",
    "test:e2e": "playwright test --config tests/release.playwright.config.ts",
    "check-codes": "node scripts/check-codes.mjs"
  },
  "dependencies": {
    "framer-motion": "^13.0.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "7.18.2",
    "sonner": "^2.0.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
